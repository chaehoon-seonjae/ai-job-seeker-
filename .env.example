# LLM 제공자 선택: openai | anthropic | google | ollama (기본: openai)
AI_PROVIDER=openai
# 모델 지정 (비우면 제공자별 기본값: gpt-4o-mini / claude-opus-5 / gemini-2.5-flash, ollama는 필수)
#AI_MODEL=
# 선택한 제공자의 키만 설정하면 됩니다. 키가 없으면 mock 분석 결과를 반환합니다.
OPENAI_API_KEY=your_openai_api_key_here
#ANTHROPIC_API_KEY=
#GOOGLE_GENERATIVE_AI_API_KEY=
# ollama 사용 시 (OpenAI 호환 엔드포인트)
#OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional: prepend paths for the k-skill spawned process.
# On Windows use semicolon-separated paths (example):
# JOBMATCH_PREPEND_PATH=C:\\Users\\CNXK\\AppData\\Local\\Programs\\Python\\Python311;C:\\Program Files\\nodejs;
# On macOS / Linux use colon-separated paths (example):
# JOBMATCH_PREPEND_PATH=/usr/local/bin:/usr/bin
# Optional: absolute path to npx (useful on Windows if npx resolution fails)
#NPX_PATH=C:\\Program Files\\nodejs\\npx.cmd
